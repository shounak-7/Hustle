# Hustle Backend Configuration
PORT=5001
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/hustle?retryWrites=true&w=majority&appName=Cluster0
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Google OAuth Credentials (for Customer Google OneTap / Signin)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback

# Google Maps API Key (for Location Gate & Reverse Geocoding)
GOOGLE_MAPS_KEY=your_google_maps_api_key

# Google Gemini AI Credentials (for smart diagnostics & price guide)
GEMINI_API_KEY=your_gemini_api_key

# Operations Staff Admin Credentials (Configure privately in .env)
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_secure_admin_password
